# Copy to .env and run:  uvicorn main:app --reload --env-file .env
YT_API_KEY=your-youtube-data-api-v3-key
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://retro:retro@localhost:5432/retrotube
REDIS_URL=redis://localhost:6379/0
FEATURED_REGION=US
# search.list costs 100 quota units per uncached call; related videos use it.
ENABLE_RELATED=0
# Set to 1 when serving over HTTPS so the session cookie is Secure.
HTTPS_ONLY=0
